# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# PIN to protect the /setup command on Telegram (pick anything)
SETUP_PIN=

# Bot display name (default: OpenClaw)
BOT_NAME=OpenClaw

# Optional: state sync interval in seconds (default: 60)
# SYNC_INTERVAL=60

# Optional: Proton Drive folder name (default: OpenClaw)
# SYNC_REMOTE_PATH=OpenClaw
