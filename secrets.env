# Maps env var names to pass:// URIs in Proton Pass.
# pass-cli run resolves these before starting OpenClaw.
# Add new secrets here after adding them to your "OpenClaw" vault.

# AI provider
GOOGLE_GENERATIVE_AI_API_KEY='pass://OpenClaw/Gemini/password'

# Gateway access token
OPENCLAW_GATEWAY_TOKEN='pass://OpenClaw/Gateway Token/password'

# Optional providers (uncomment as needed):
# ANTHROPIC_API_KEY='pass://OpenClaw/Anthropic/password'
# OPENAI_API_KEY='pass://OpenClaw/OpenAI/password'
# OPENROUTER_API_KEY='pass://OpenClaw/OpenRouter/password'
